#' spi_data(country = "NOR", year = 2020:2024)
#'
#' # Only Pillar 3 (Data Products) columns
#' spi_data(pillar = 3)
#'
#' # Specific dimension
#' spi_data(dimension = "4.1")
#' }
#'
#' @export
spi_data <- function(version = "master",
country = NULL,
year = NULL,
pillar = NULL,
dimension = NULL) {
spi_get(
type      = "data",
version   = version,
country   = country,
year      = year,
pillar    = pillar,
dimension = dimension
)
}
library(spiR)
install.packages("languageserver")
library(spiR)
library(spiR)
r1 <- spi_indicator("SPI.D5.2.2.NABY", country = "CHL", year = 2024)
spi_get(
type      = "data",
version   = version,
country   = country,
year      = year,
pillar    = pillar,
dimension = dimension
)
r1
}
